# Telegram Bot API Token & Admin (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id_here

# Telegram Group / Channel Verification
# ID of the group/channel (e.g. -1001234567890 or @your_channel). Bot must be an administrator with view members rights.
TELEGRAM_REQUIRED_CHAT_ID=-1001234567890
# Public or private invite link for users who haven't joined yet
TELEGRAM_GROUP_INVITE_LINK=https://t.me/your_group_link
# Base Web App URL (for direct link and Mini App)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Custom Telegram Bot API root (if proxy or local bot server is needed)
# TELEGRAM_API_ROOT=https://api.telegram.org
# Optional: Secret token for verifying webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# OpenAI API Configuration for Text Analysis & Gene Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional: custom base URL (e.g. if using a proxy or compatible endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

